#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
export CLANG_MODULE_CACHE_PATH="$scratch/modules"
swiftc -module-cache-path "$CLANG_MODULE_CACHE_PATH" Bridge/Wire.swift Bridge/RequestGate.swift RCJ/Store.swift Tests/Check.swift -o "$scratch/check"
"$scratch/check"
swift build --build-path "$scratch/build" --disable-sandbox
python3 Tests/mcp.py "$scratch/build/debug/rcj-bridge"
